generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  accounts    Account[]
  aiUsageLogs AiUsageLog[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  type              String   @default("oauth")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AiUsageLog {
  id               String   @id @default(uuid())
  userId           String
  traceHash        String   @unique
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Decimal  @db.Decimal(19, 4)
  model            String
  latencyMs        Int
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuantoMother {
  id         String        @id @default(uuid()) @db.Uuid
  motherCode String        @unique @db.VarChar(64)
  version    String        @default("3.2.0")
  createdAt  DateTime      @default(now())
  children   ChildQuanto[]
}

model ChildQuanto {
  id         String  @id @default(uuid()) @db.Uuid
  quantaHash String  @unique @db.VarChar(128)
  parentHash String? @db.VarChar(128)
  motherId   String  @db.Uuid
  ownerId    String  @db.Uuid
  isHead     Boolean @default(true)

  title       String
  description String   @db.Text
  mediaUrls   String[]

  priceDecimal   Decimal @db.Decimal(19, 4)
  currency       String  @default("USD") @db.VarChar(3)
  stockAvailable Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mother QuantoMother @relation(fields: [motherId], references: [id])

  @@index([quantaHash])
  @@index([ownerId])
}
